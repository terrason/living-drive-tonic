    },
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "build": "bun run build.ts"
    },
    "dependencies": {
        "@stricli/auto-complete": "^1.2.6",
        "@stricli/core": "^1.2.6",
        "drizzle-orm": "^0.45.2"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "drizzle-kit": "^0.31.10"
    }
}